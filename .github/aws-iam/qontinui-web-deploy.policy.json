{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EcrLogin",
            "Effect": "Allow",
            "Action": [
                "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EcrPushAndDescribeWebBackend",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:DescribeImages",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
            ],
            "Resource": "arn:aws:ecr:us-east-1:047719635665:repository/qontinui-web-backend"
        },
        {
            "Sid": "EcsDescribeTaskDefinition",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTaskDefinition"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EcsRegisterWebTaskDefinition",
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:task-definition/qontinui-staging-web:*"
        },
        {
            "Sid": "EcsDescribeAndUpdateWebService",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeServices",
                "ecs:UpdateService"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:service/qontinui-staging/web"
        },
        {
            "Sid": "EcsRunWebOneOffTask",
            "Effect": "Allow",
            "Action": [
                "ecs:RunTask"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:task-definition/qontinui-staging-web:*",
            "Condition": {
                "ArnEquals": {
                    "ecs:cluster": "arn:aws:ecs:us-east-1:047719635665:cluster/qontinui-staging"
                }
            }
        },
        {
            "Sid": "EcsDescribeTasksInCluster",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTasks"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:task/qontinui-staging/*",
            "Condition": {
                "ArnEquals": {
                    "ecs:cluster": "arn:aws:ecs:us-east-1:047719635665:cluster/qontinui-staging"
                }
            }
        },
        {
            "Sid": "PassWebTaskRolesToEcs",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": [
                "arn:aws:iam::047719635665:role/qontinui-staging-web-exec",
                "arn:aws:iam::047719635665:role/qontinui-staging-web-task"
            ],
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            }
        },
        {
            "Sid": "ReadWebLogs",
            "Effect": "Allow",
            "Action": [
                "logs:DescribeLogStreams",
                "logs:GetLogEvents"
            ],
            "Resource": [
                "arn:aws:logs:us-east-1:047719635665:log-group:/ecs/qontinui-staging/web",
                "arn:aws:logs:us-east-1:047719635665:log-group:/ecs/qontinui-staging/web:*"
            ]
        },
        {
            "Sid": "ReadSpecCiSsmParams",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter"
            ],
            "Resource": [
                "arn:aws:ssm:eu-central-1:047719635665:parameter/qontinui/spec-ci/auth-email",
                "arn:aws:ssm:eu-central-1:047719635665:parameter/qontinui/spec-ci/auth-password"
            ]
        },
        {
            "Sid": "DecryptSsmSecureStringViaSsm",
            "Effect": "Allow",
            "Action": [
                "kms:Decrypt"
            ],
            "Resource": "arn:aws:kms:eu-central-1:047719635665:key/464deccc-ffdc-4209-b776-86770947401c",
            "Condition": {
                "StringEquals": {
                    "kms:ViaService": "ssm.eu-central-1.amazonaws.com"
                }
            }
        }
    ]
}

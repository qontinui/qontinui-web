{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EcrLogin",
            "Effect": "Allow",
            "Action": [
                "ecr:GetAuthorizationToken"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EcrEnsureAndPushMigrator",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:CreateRepository",
                "ecr:DescribeRepositories",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
            ],
            "Resource": "arn:aws:ecr:us-east-1:047719635665:repository/qontinui-migrator"
        },
        {
            "Sid": "EcsDescribeTaskDefinition",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTaskDefinition"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EcsRegisterMigratorTaskDefinition",
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:task-definition/qontinui-staging-migrator:*"
        },
        {
            "Sid": "EcsRunMigratorTask",
            "Effect": "Allow",
            "Action": [
                "ecs:RunTask"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:task-definition/qontinui-staging-migrator:*",
            "Condition": {
                "ArnEquals": {
                    "ecs:cluster": "arn:aws:ecs:us-east-1:047719635665:cluster/qontinui-staging"
                }
            }
        },
        {
            "Sid": "EcsDescribeTasksInCluster",
            "Effect": "Allow",
            "Action": [
                "ecs:DescribeTasks"
            ],
            "Resource": "arn:aws:ecs:us-east-1:047719635665:task/qontinui-staging/*",
            "Condition": {
                "ArnEquals": {
                    "ecs:cluster": "arn:aws:ecs:us-east-1:047719635665:cluster/qontinui-staging"
                }
            }
        },
        {
            "Sid": "PassMigratorTaskRolesToEcs",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": [
                "arn:aws:iam::047719635665:role/qontinui-staging-migrator-exec",
                "arn:aws:iam::047719635665:role/qontinui-staging-migrator-task"
            ],
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            }
        },
        {
            "Sid": "ReadMigratorLogs",
            "Effect": "Allow",
            "Action": [
                "logs:GetLogEvents"
            ],
            "Resource": [
                "arn:aws:logs:us-east-1:047719635665:log-group:/ecs/qontinui-staging/migrator",
                "arn:aws:logs:us-east-1:047719635665:log-group:/ecs/qontinui-staging/migrator:*"
            ]
        }
    ]
}

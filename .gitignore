# Claude development guidelines (local only)
CLAUDE.md

# Coverage reports
coverage.xml
.vercel
.claude/

# AWS password reset example config
backend/reset_aws_password.example.env
.worktrees/

.vercel
.env*

# npm is the canonical package manager for frontend/ (CI npm ci + Vercel use
# package-lock.json); stray lockfiles from other managers must never be committed.
frontend/pnpm-lock.yaml
frontend/yarn.lock

# coord-mcp device credential (nonce/JWT) is written into the worktree as
# .mcp.json at launch. It is a live credential and must never be committed.
# (Was previously only in .git/info/exclude — local-only, lost on fresh clone/CI.)
.mcp.json

# Git-Bash crash dumps — never commit
*.stackdump

# Composed cloud build (frontend/scripts/vercel-install.sh) — both generated
# at install time on the deployment, never committed. See
# frontend/docs/composed-cloud-build.md.
/.sibling/
frontend/public/composed-build.json
